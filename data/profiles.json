{
  "muggle": {
    "name": "Muggle",
    "description": "The 101 basics for everyday, non-technical use: a browser, chat and video calls, music, office documents, passwords, a cleanup tool and friendly AI assistants. Pick what you like in each part",
    "slots": [
      {
        "name": "Browser",
        "pick": "one",
        "apps": [
          "google-chrome",
          "firefox",
          "brave-browser"
        ],
        "defaults": [
          "google-chrome"
        ]
      },
      {
        "name": "Chat & calls",
        "pick": "any",
        "apps": [
          "whatsapp",
          "zoom",
          "telegram",
          "signal"
        ],
        "defaults": [
          "whatsapp",
          "zoom"
        ]
      },
      {
        "name": "Music & video",
        "pick": "any",
        "apps": [
          "spotify",
          "vlc",
          "iina"
        ],
        "defaults": [
          "spotify",
          "vlc"
        ]
      },
      {
        "name": "AI assistant",
        "pick": "any",
        "apps": [
          "chatgpt",
          "claude"
        ],
        "defaults": [
          "chatgpt",
          "claude"
        ]
      },
      {
        "name": "Passwords",
        "pick": "one",
        "apps": [
          "bitwarden",
          "1password"
        ],
        "defaults": [
          "bitwarden"
        ]
